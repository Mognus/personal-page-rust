# Nginx reverse proxy for freierfreier23.de
# Place at: /etc/nginx/sites-available/default
# After editing: sudo nginx -t && sudo systemctl reload nginx
#
# Note: this app is a BFF — the browser only talks to the Next.js frontend, which
# reaches the backend internally over the docker network. So nginx only proxies
# the frontend; there is no public /api route and the backend stays internal.

# Redirect all HTTP traffic to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name freierfreier23.de www.freierfreier23.de;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name freierfreier23.de www.freierfreier23.de;

    # SSL certs managed by Certbot — do not edit manually
    ssl_certificate /etc/letsencrypt/live/freierfreier23.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/freierfreier23.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Everything goes to the Next.js frontend container (port 3000).
    location / {
        proxy_pass http://localhost:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
