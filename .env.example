# Copy to .env (gitignored). On the server this lives at ~/personal-page.env and
# the deploy workflow copies it into place. Fill in real secrets there.

# --- Project ---
# Prefixes container names (e.g. personal-page-postgres); used by the backup step.
PROJECT_NAME=personal-page

# --- Caddy ---
# ":80" serves plain HTTP for a local production smoke test. On the server use
# the bare domain (no scheme) so Caddy provisions and renews HTTPS automatically.
SITE_ADDRESS=:80
# Enable only when the www DNS record exists.
# WWW_ADDRESS=www.freierfreier23.de

# --- Postgres ---
POSTGRES_DB=personal_page
POSTGRES_USER=personal_page
POSTGRES_PASSWORD=change_me
# Only published by docker-compose.dev.yml; prod keeps Postgres internal.
POSTGRES_PORT=5432

# --- Backend ---
JWT_SECRET=change_me
JWT_EXPIRES_IN_SECONDS=3600

# --- Frontend (Next BFF) ---
# Backend base URL over the compose network (service name, not localhost).
BACKEND_URL=http://backend:8080

# --- GitHub (live content for the projects + personal-setup views) ---
GITHUB_DOTFILES_REPO=Mognus/linux-dotfiles
# Personal access token to lift the GitHub API rate limit (60/h -> 5000/h).
GITHUB_TOKEN=

# --- Seeds (off-repo) ---
# Server folder holding the real configs.json / projects.json (mounted at /seeds
# in the backend). Defaults to ./backend/seeds (only *.example in a checkout).
SEEDS_DIR=/home/magnus/personal-page-seeds

# --- Docs (off-repo) ---
# Server folder holding the private PDFs served by the auth-gated /api/docs route
# (mounted at /docs in the frontend). Expected files: magnus-lebenslauf.pdf,
# magnus-zeugnisse.pdf and magnus-abilities.pdf. Gitignored; defaults to
# ./frontend/private in a checkout.
DOCS_DIR=/home/magnus/personal-page-docs
