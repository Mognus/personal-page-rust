FROM node:24-alpine

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN corepack enable

EXPOSE 3000

# Dev deps are installed at startup against a named volume (see docker-compose.dev.yml),
# so dependency changes are picked up on container restart — no image rebuild and no
# anonymous-volume juggling. Source is bind-mounted, so there's no COPY here.
# Next 16's `next dev` already binds to 0.0.0.0, so no host flag is needed.
CMD ["sh", "-c", "pnpm install && pnpm dev"]
